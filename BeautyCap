    const clearFilterBtn = document.getElementById('clearFilterBtn');
    const randomBtn = document.getElementById('randomBtn');
    const toastEl = document.getElementById('toast');

    let toastTimer = null;

    function escapeHtml(str) {
      return str
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#039;');
    }

    function showToast(message) {
      toastEl.textContent = message;
      toastEl.classList.add('show');
      clearTimeout(toastTimer);
      toastTimer = setTimeout(() => {
        toastEl.classList.remove('show');
      }, 2200);
    }

    function copyText(text, successMsg) {
      if (navigator.clipboard && window.isSecureContext) {
        navigator.clipboard.writeText(text)
          .then(() => showToast(successMsg))
          .catch(() => fallbackCopy(text, successMsg));
      } else {
        fallbackCopy(text, successMsg);
      }
    }

    function fallbackCopy(text, successMsg) {
      const textarea = document.createElement('textarea');
      textarea.value = text;
      textarea.style.position = 'fixed';
      textarea.style.opacity = '0';
      document.body.appendChild(textarea);
      textarea.select();
      try {
        document.execCommand('copy');
        showToast(successMsg);
      } catch (e) {
        showToast('ไม่สามารถคัดลอกอัตโนมัติได้ กรุณาก๊อปปี้ด้วยตนเอง');
      }
      document.body.removeChild(textarea);
    }

    function getPlainCaption(item) {
      const targetName = productName.trim() || item.defaultProduct;
      return item.caption.replace(/\{product\}/g, targetName);
    }

    function getHighlightedCaptionHTML(item) {
      const targetName = productName.trim() || item.defaultProduct;
      const safeCaption = escapeHtml(item.caption);
      const safeProduct = escapeHtml(targetName);
      return safeCaption.replace(/\{product\}/g, `<span class="product-highlight">${safeProduct}</span>`);
    }

    function toggleFavorite(id) {
      if (favorites.includes(id)) {
        favorites = favorites.filter(favId => favId !== id);
        showToast('นำออกจากรายการที่บันทึกแล้ว');
      } else {
        favorites.push(id);
        showToast('บันทึกแคปชั่นที่ชอบแล้ว ❤️');
      }
      localStorage.setItem('beautycap_favs', JSON.stringify(favorites));
      renderCards();
    }

    function renderFilters() {
      categoryPillsEl.innerHTML = CATEGORIES.map(cat => `
        <button class="pill ${selectedCategory === cat.id ? 'active' : ''}" data-cat="${cat.id}">
          ${cat.label}
        </button>
      `).join('');

      tonePillsEl.innerHTML = TONES.map(tone => `
        <button class="pill tone-pill ${selectedTone === tone.id ? 'active' : ''}" data-tone="${tone.id}">
          ${tone.label}
        </button>
      `).join('');

      categoryPillsEl.querySelectorAll('.pill').forEach(btn => {
        btn.addEventListener('click', () => {
          selectedCategory = btn.dataset.cat;
          renderFilters();
          renderCards();
        });
      });

      tonePillsEl.querySelectorAll('.pill').forEach(btn => {
        btn.addEventListener('click', () => {
          selectedTone = btn.dataset.tone;
          renderFilters();
          renderCards();
        });
      });
    }

    function getFilteredItems() {
      const q = searchQuery.trim().toLowerCase();
      return DATA.filter(item => {
        const matchCat =
          selectedCategory === 'all' ||
          (selectedCategory === 'favorites' ? favorites.includes(item.id) : item.category === selectedCategory);

        const matchTone = selectedTone === 'all' || item.tone === selectedTone;

        const plainCap = getPlainCaption(item).toLowerCase();
        const matchQuery =
          !q ||
          plainCap.includes(q) ||
          item.hashtags.toLowerCase().includes(q) ||
          item.catLabel.toLowerCase().includes(q);

        return matchCat && matchTone && matchQuery;
      });
    }

    function renderCards(forcedItems = null) {
      const items = forcedItems || getFilteredItems();

      const hasActiveFilter = selectedCategory !== 'all' || selectedTone !== 'all' || searchQuery.trim() !== '';
      clearFilterBtn.style.display = hasActiveFilter ? 'inline' : 'none';

      resultCountEl.textContent = forcedItems
        ? '🎲 แคปชั่นสุ่มแนะนำสำหรับคุณ'
        : `พบ ${items.length} แคปชั่นคู่แฮชแท็ก`;

      if (items.length === 0) {
        cardsGridEl.innerHTML = `
          <div class="empty-state">
            <div style="font-size:2rem; margin-bottom:8px;">🔍</div>
            <p><strong>ไม่พบแคปชั่นที่ตรงกับตัวกรองนี้</strong></p>
            <p style="font-size:0.88rem; margin-top:4px;">ลองเปลี่ยนหมวดหมู่หรือลบคำค้นหาดูนะครับ</p>
          </div>
        `;
        return;
      }

      cardsGridEl.innerHTML = items.map(item => {
        const isFav = favorites.includes(item.id);
        return `
          <article class="card">
            <div>
              <div class="card-header">
                <div class="badges">
                  <span class="badge badge-cat">${item.catLabel}</span>
                  <span class="badge badge-tone">${item.tone}</span>
                </div>
                <button class="fav-btn ${isFav ? 'saved' : ''}" data-fav="${item.id}" title="บันทึกแคปชั่นนี้">
                  ${isFav ? '♥' : '♡'}
                </button>
              </div>

              <div class="caption-box">${getHighlightedCaptionHTML(item)}</div>
              <div class="hashtag-box">${escapeHtml(item.hashtags)}</div>
            </div>

            <div class="card-actions">
              <button class="btn-copy btn-copy-all" data-copy-all="${item.id}">
                📋 คัดลอกทั้งหมด
              </button>
              <button class="btn-copy btn-copy-sub" data-copy-cap="${item.id}">
                แคปชั่น
              </button>
              <button class="btn-copy btn-copy-sub" data-copy-tag="${item.id}">
                #แท็ก
              </button>
            </div>
          </article>
        `;
      }).join('');

      // Attach listeners
      cardsGridEl.querySelectorAll('[data-fav]').forEach(btn => {
        btn.addEventListener('click', () => toggleFavorite(Number(btn.dataset.fav)));
      });

      cardsGridEl.querySelectorAll('[data-copy-all]').forEach(btn => {
        btn.addEventListener('click', () => {
          const item = DATA.find(d => d.id === Number(btn.dataset.copyAll));
          const fullText = `${getPlainCaption(item)}\n\n${item.hashtags}`;
          copyText(fullText, 'คัดลอกแคปชั่น + แฮชแท็กแล้ว! ✨');
        });
      });

      cardsGridEl.querySelectorAll('[data-copy-cap]').forEach(btn => {
        btn.addEventListener('click', () => {
          const item = DATA.find(d => d.id === Number(btn.dataset.copyCap));
          copyText(getPlainCaption(item), 'คัดลอกเฉพาะแคปชั่นแล้ว! 📝');
        });
      });

      cardsGridEl.querySelectorAll('[data-copy-tag]').forEach(btn => {
        btn.addEventListener('click', () => {
          const item = DATA.find(d => d.id === Number(btn.dataset.copyTag));
          copyText(item.hashtags, 'คัดลอกเฉพาะแฮชแท็กแล้ว! #️⃣');
        });
      });
    }

    // Event Listeners
    productInputEl.addEventListener('input', (e) => {
      productName = e.target.value;
      renderCards();
    });

    searchInputEl.addEventListener('input', (e) => {
      searchQuery = e.target.value;
      renderCards();
    });

    clearFilterBtn.addEventListener('click', () => {
      selectedCategory = 'all';
      selectedTone = 'all';
      searchQuery = '';
      searchInputEl.value = '';
      renderFilters();
      renderCards();
    });

    randomBtn.addEventListener('click', () => {
      const pool = getFilteredItems();
      const source = pool.length > 0 ? pool : DATA;
      const randomItem = source[Math.floor(Math.random() * source.length)];
      renderCards([randomItem]);
      showToast('สุ่มแคปชั่นป้ายยาให้แล้ว! 🎲');
    });

    // Init
    renderFilters();
    renderCards();
  </script>
</body>
</html>
