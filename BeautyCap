<!DOCTYPE html>
<html lang="th">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>BeautyCap ✨ แคปชั่น & แฮชแท็กรีวิวสกินแคร์และความงาม</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Prompt:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <style>
    :root {
      --bg: #fdf8fa;
      --surface: #ffffff;
      --primary: #e15b8c;
      --primary-hover: #c94676;
      --primary-soft: #fdebf2;
      --secondary: #8a5cf5;
      --secondary-soft: #f2edfe;
      --text-main: #2d232a;
      --text-muted: #766871;
      --border: #f0e1e8;
      --shadow: 0 8px 24px rgba(225, 91, 140, 0.08);
      --radius: 18px;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      font-family: 'Prompt', -apple-system, BlinkMacSystemFont, sans-serif;
      background-color: var(--bg);
      background-image: radial-gradient(circle at 10% 10%, #fce8f0 0%, transparent 40%),
                        radial-gradient(circle at 90% 20%, #f1ebff 0%, transparent 35%);
      color: var(--text-main);
      line-height: 1.6;
      min-height: 100vh;
      padding-bottom: 60px;
    }

    .container {
      max-width: 1120px;
      margin: 0 auto;
      padding: 0 18px;
    }

    /* Header */
    header {
      text-align: center;
      padding: 36px 16px 24px;
    }

    .brand-badge {
      display: inline-block;
      background: linear-gradient(135deg, var(--primary-soft), var(--secondary-soft));
      color: var(--primary);
      font-size: 0.85rem;
      font-weight: 600;
      padding: 6px 14px;
      border-radius: 99px;
      margin-bottom: 10px;
      border: 1px solid #f7d6e3;
    }

    h1 {
      font-size: clamp(1.6rem, 3.5vw, 2.3rem);
      font-weight: 700;
      color: var(--text-main);
      margin-bottom: 8px;
    }

    h1 span {
      background: linear-gradient(135deg, var(--primary), var(--secondary));
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
    }

    .subtitle {
      color: var(--text-muted);
      font-size: 0.95rem;
      max-width: 580px;
      margin: 0 auto;
    }

    /* Control Panel */
    .control-panel {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      padding: 20px;
      box-shadow: var(--shadow);
      margin-bottom: 24px;
    }

    .input-row {
      display: grid;
      grid-template-columns: 1fr 1fr auto;
      gap: 12px;
      margin-bottom: 18px;
    }

    @media (max-width: 768px) {
      .input-row {
        grid-template-columns: 1fr;
      }
    }

    .input-group {
      position: relative;
    }

    .input-group label {
      display: block;
      font-size: 0.8rem;
      font-weight: 600;
      color: var(--text-muted);
      margin-bottom: 6px;
    }

    .input-field {
      width: 100%;
      padding: 11px 14px;
      border: 1.5px solid var(--border);
      border-radius: 12px;
      font-family: inherit;
      font-size: 0.95rem;
      color: var(--text-main);
      background: #fffcfd;
      transition: border-color 0.2s, box-shadow 0.2s;
    }

    .input-field:focus {
      outline: none;
      border-color: var(--primary);
      box-shadow: 0 0 0 3px rgba(225, 91, 140, 0.12);
    }

    .btn-random {
      align-self: flex-end;
      height: 45px;
      padding: 0 18px;
      background: linear-gradient(135deg, var(--primary), var(--secondary));
      color: white;
      border: none;
      border-radius: 12px;
      font-family: inherit;
      font-size: 0.92rem;
      font-weight: 600;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      transition: transform 0.15s, opacity 0.2s;
      white-space: nowrap;
    }

    .btn-random:hover {
      opacity: 0.92;
      transform: translateY(-1px);
    }

    /* Filter Pills */
    .filter-section {
      margin-top: 10px;
    }

    .filter-label {
      font-size: 0.8rem;
      font-weight: 600;
      color: var(--text-muted);
      margin-bottom: 8px;
      display: block;
    }

    .pills-wrap {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
    }

    .pill {
      padding: 7px 14px;
      border-radius: 99px;
      border: 1px solid var(--border);
      background: #fff;
      color: var(--text-muted);
      font-family: inherit;
      font-size: 0.86rem;
      font-weight: 500;
      cursor: pointer;
      transition: all 0.2s;
    }

    .pill:hover {
      border-color: var(--primary);
      color: var(--primary);
    }

    .pill.active {
      background: var(--primary);
      color: #fff;
      border-color: var(--primary);
      box-shadow: 0 4px 12px rgba(225, 91, 140, 0.25);
    }

    .pill.tone-pill.active {
      background: var(--secondary);
      border-color: var(--secondary);
      box-shadow: 0 4px 12px rgba(138, 92, 245, 0.25);
    }

    /* Status Bar */
    .status-bar {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 16px;
      font-size: 0.9rem;
      color: var(--text-muted);
    }

    /* Cards Grid */
    .cards-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(330px, 1fr));
      gap: 20px;
    }

    @media (max-width: 480px) {
      .cards-grid {
        grid-template-columns: 1fr;
      }
    }

    .card {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      padding: 20px;
      box-shadow: var(--shadow);
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      transition: transform 0.2s, box-shadow 0.2s;
    }

    .card:hover {
      transform: translateY(-3px);
      box-shadow: 0 12px 28px rgba(225, 91, 140, 0.13);
    }

    .card-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 14px;
      gap: 8px;
    }

    .badges {
      display: flex;
      flex-wrap: wrap;
      gap: 6px;
    }

    .badge {
      font-size: 0.75rem;
      font-weight: 600;
      padding: 4px 10px;
      border-radius: 99px;
    }

    .badge-cat {
      background: var(--primary-soft);
      color: var(--primary);
    }

    .badge-tone {
      background: var(--secondary-soft);
      color: var(--secondary);
    }

    .fav-btn {
      background: none;
      border: none;
      cursor: pointer;
      font-size: 1.25rem;
      line-height: 1;
      padding: 4px;
      color: #d4c4cd;
      transition: transform 0.15s, color 0.15s;
    }

    .fav-btn:hover {
      transform: scale(1.15);
    }

    .fav-btn.saved {
      color: #e15b8c;
    }

    .caption-box {
      font-size: 0.98rem;
      color: var(--text-main);
      margin-bottom: 14px;
      white-space: pre-line;
      word-break: break-word;
    }

    .product-highlight {
      color: var(--primary);
      font-weight: 600;
      background: var(--primary-soft);
      padding: 0 5px;
      border-radius: 6px;
    }

    .hashtag-box {
      background: #faf6f9;
      border: 1px dashed #e6d3de;
      border-radius: 12px;
      padding: 10px 12px;
      font-size: 0.85rem;
      color: #8b5c9e;
      margin-bottom: 16px;
      line-height: 1.5;
      word-break: break-word;
    }

    .card-actions {
      display: grid;
      grid-template-columns: 1fr auto auto;
      gap: 8px;
      margin-top: auto;
    }

    .btn-copy {
      padding: 9px 12px;
      border-radius: 10px;
      font-family: inherit;
      font-size: 0.84rem;
      font-weight: 600;
      cursor: pointer;
      border: none;
      transition: all 0.15s;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 5px;
    }

    .btn-copy-all {
      background: var(--primary);
      color: white;
    }

    .btn-copy-all:hover {
      background: var(--primary-hover);
    }

    .btn-copy-sub {
      background: var(--primary-soft);
      color: var(--primary);
    }

    .btn-copy-sub:hover {
      background: #fad8e6;
    }

    /* Empty State */
    .empty-state {
      grid-column: 1 / -1;
      text-align: center;
      padding: 48px 20px;
      background: var(--surface);
      border-radius: var(--radius);
      border: 1px dashed var(--border);
      color: var(--text-muted);
    }

    /* Toast */
    .toast {
      position: fixed;
      bottom: 24px;
      left: 50%;
      transform: translateX(-50%) translateY(80px);
      background: #2d232a;
      color: white;
      padding: 12px 22px;
      border-radius: 99px;
      font-size: 0.9rem;
      font-weight: 500;
      box-shadow: 0 10px 25px rgba(0, 0, 0, 0.2);
      opacity: 0;
      transition: all 0.3s cubic-bezier(0.18, 0.89, 0.32, 1.28);
      z-index: 999;
      pointer-events: none;
    }

    .toast.show {
      transform: translateX(-50%) translateY(0);
      opacity: 1;
    }
  </style>
</head>
